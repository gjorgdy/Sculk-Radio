{
  "schemaVersion": 1,
  "id": "sculk-radio",
  "version": "${version}",
  "name": "Sculk Radio",
  "description": "",
  "authors": ["Gjorgdy"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/sculk_radio/logo.jpg",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.gjorgdy.sculk_radio.FabricSculkRadio"
    ],
    "voicechat": [
      "nl.gjorgdy.sculk_radio.compat.voicechat.SculkRadioVoiceChatPlugin"
    ]
  },

  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "voicechat": ">=${voicechat_api_version}",
    "audioplayer": ">=${audioplayer_api_version}",
    "fzzy-config": ">=${fzzy_config_version}"
  }
}